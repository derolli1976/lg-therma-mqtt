# LG ThinQ Credentials
LG_EMAIL=shopping@oliverstock.name
LG_PASSWORD=dein-passwort-hier
LG_COUNTRY=DE
LG_LANGUAGE=de-DE
DEVICE_ID=360b049f-2877-1bb1-9863-c8dd6a744d5b

# MQTT Broker Configuration
MQTT_BROKER=192.168.1.100
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=homeassistant

# Update interval (seconds). LG throttles aggressive polling of the unofficial
# API; higher values (60-120+) make the "official API" nudge much less likely.
INTERVAL=30

# Recovery tuning (all optional, sensible defaults shown).
# MAX_BACKOFF: upper bound (seconds) for the escalating backoff after a failed
#   poll. We back off quietly instead of hammering, so the rate window recovers.
# RELOGIN_AFTER_FAILURES: consecutive failures before the first fresh-login
#   attempt (a fresh login only helps after a quiet pause, not as a burst).
# RELOGIN_EVERY_FAILURES: retry a fresh login every N failures thereafter.
MAX_BACKOFF=600
RELOGIN_AFTER_FAILURES=3
RELOGIN_EVERY_FAILURES=3
